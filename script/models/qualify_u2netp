#!/usr/bin/env bash
set -Eeuo pipefail

readonly UPSTREAM_REPOSITORY='https://github.com/xuebinqin/U-2-Net'
readonly UPSTREAM_REVISION='ac7e1c817ecab7c7dff5ce6b1abba61cd213ff29'
readonly WEIGHTS_URL='https://drive.google.com/uc?export=download&id=1rbSTGKAE-MTxBYHd-51l2hMOQPT_7EPy'
readonly WEIGHTS_SHA256='e7567cde013fb64813973ce6e1ecc25a80c05c3ca7adbc5a54f3c3d90991b854'
readonly WEIGHTS_SIZE='4683258'
readonly CONVERTER_IMAGE='rails-8-ai-u2netp-converter'

usage() {
  printf '%s\n' 'Usage: script/models/qualify_u2netp [--qualify]'
  printf '%s\n' 'Without --qualify, validates and atomically installs var/models/u2netp.onnx from the committed manifest.'
  printf '%s\n' 'With --qualify, builds a temporary candidate and prints its provenance without writing a manifest or var/models.'
}

mode='install'
while (( $# > 0 )); do
  case "$1" in
    --qualify)
      mode='qualify'
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

for command in git curl docker sha256sum wc; do
  command -v "$command" >/dev/null || {
    printf 'required command is unavailable: %s\n' "$command" >&2
    exit 1
  }
done

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/u2netp-qualification.XXXXXX")"

source_directory="$temporary_directory/U-2-Net"
weights_path="$temporary_directory/u2netp.pth"
candidate_directory="$temporary_directory/candidate"
candidate_path="$candidate_directory/u2netp.onnx"
install_directory=''

cleanup() {
  rm -rf "$temporary_directory"
  [[ -z "$install_directory" ]] || rm -rf "$install_directory"
}
trap cleanup EXIT
git clone --quiet "$UPSTREAM_REPOSITORY" "$source_directory"
git -C "$source_directory" checkout --quiet --detach "$UPSTREAM_REVISION"
test "$(git -C "$source_directory" rev-parse HEAD)" = "$UPSTREAM_REVISION"

curl --fail --location --retry 3 --output "$weights_path" "$WEIGHTS_URL"
test "$(wc -c < "$weights_path" | tr -d ' ')" = "$WEIGHTS_SIZE"
test "$(sha256sum "$weights_path" | awk '{print $1}')" = "$WEIGHTS_SHA256"

docker build --quiet --tag "$CONVERTER_IMAGE" \
  --file "$repository_root/docker/models/u2netp/Dockerfile" \
  "$repository_root/docker/models/u2netp"
mkdir -p "$candidate_directory"
docker run --rm \
  --user "$(id -u):$(id -g)" \
  --volume "$repository_root:/workspace:ro" \
  --volume "$source_directory:/source:ro" \
  --volume "$weights_path:/weights/u2netp.pth:ro" \
  --volume "$candidate_directory:/output" \
  "$CONVERTER_IMAGE" \
  --source-directory /source \
  --weights /weights/u2netp.pth \
  --output /output/u2netp.onnx

test -f "$candidate_path"

if [[ -n "${VERIFY_COMMAND:-}" ]]; then
  U2NETP_CANDIDATE="$candidate_path" bash -lc "$VERIFY_COMMAND"
else
  U2NETP_CANDIDATE="$candidate_path" bundle exec ruby -ronnxruntime -e '
    model = OnnxRuntime::Model.new(ENV.fetch("U2NETP_CANDIDATE"))
    input = model.inputs.map { |port| [port.fetch(:name).to_s, port.fetch(:type).to_s, port.fetch(:shape)] }
    output = model.outputs.map { |port| [port.fetch(:name).to_s, port.fetch(:type).to_s, port.fetch(:shape)] }
    abort "unexpected ONNX input" unless input == [["input", "tensor(float)", [1, 3, 320, 320]]]
    abort "unexpected ONNX output" unless output == [["d0", "tensor(float)", [1, 1, 320, 320]]]
  '
fi

onnx_sha256="$(sha256sum "$candidate_path" | awk '{print $1}')"
onnx_file_size="$(wc -c < "$candidate_path" | tr -d ' ')"

if [[ "$mode" == 'qualify' ]]; then
  printf 'onnx_sha256=%s\n' "$onnx_sha256"
  printf 'onnx_file_size=%s\n' "$onnx_file_size"
  exit 0
fi

manifest_path="$repository_root/config/models/u2netp.yml"
if ! MANIFEST_PATH="$manifest_path" ARTIFACT_PATH="$candidate_path" bundle exec ruby -r ./config/environment -e '
  manifest = ImageLab::AI::U2netpManifest.load!(path: ENV.fetch("MANIFEST_PATH"))
  manifest.verify_artifact!(path: ENV.fetch("ARTIFACT_PATH"), kind: :onnx)
'; then
  printf '%s\n' 'ONNX candidate does not match the committed manifest' >&2
  exit 1
fi

model_directory="$repository_root/var/models"
mkdir -p "$model_directory"
install_directory="$(mktemp -d "$model_directory/.u2netp-install.XXXXXX")"
cp "$candidate_path" "$install_directory/u2netp.onnx"
mv -f "$install_directory/u2netp.onnx" "$model_directory/u2netp.onnx"
printf 'installed=%s\n' "$model_directory/u2netp.onnx"
